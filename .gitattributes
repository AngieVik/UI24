# EOL: todos los archivos de texto normalizan a LF.
# En Windows el checkout puede ser CRLF (git config core.autocrlf),
# pero el repositorio almacena siempre LF.
* text=auto eol=lf

*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.sh    text eol=lf eol=lf

# Binarios — sin normalización
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
