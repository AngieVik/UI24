# =============================================================================
# Proyecto U24 — Variables de entorno
#
# Copia este archivo como .env.local y rellena los valores.
# NUNCA commitees .env.local ni ningún archivo con secretos reales.
# Ver: 06_operaciones/runbook-secretos.md
# =============================================================================

# --- Supabase local (supabase start) -----------------------------------------
# Ejecuta `supabase start` y copia la URL y anon key que aparecen en el output.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# --- Supabase staging (solo en CI — configurar en GitHub Secrets) -------------
# VITE_SUPABASE_URL=https://<ref-staging>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon-key-staging>

# --- Supabase producción (solo en hosting — NUNCA en disco ni en CI común) ----
# VITE_SUPABASE_URL=https://<ref-prod>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon-key-prod>

# --- Sentry (Sprint 13 — observabilidad) -------------------------------------
# VITE_SENTRY_DSN=

# --- Push / VAPID (Sprint 13 — notificaciones push) --------------------------
# VITE_VAPID_PUBLIC_KEY=
